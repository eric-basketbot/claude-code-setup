      "wrappers": [
        "~/.npm-global/bin/codex",
        "~/.local/bin/kimi-review",
        "~/.local/bin/glm-review",
        "~/.local/bin/chatgpt-plan",
        "/opt/homebrew/bin/coderabbit",
        "~/.claude/scripts/codex-implementation-fallback.sh"
      ]
    }
  },
  "codex_optional_host_managed_skill_roots": [
