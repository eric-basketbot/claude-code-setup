{
  "_comment": "Merged into ~/.claude/settings.json by install.sh. Wires ONLY the 4 JS + 2 Python hooks and the statusline that ship in this repo. Plugin-based hooks (hookify, security-guidance, etc.) are NOT here — install those separately, e.g. `/plugin install hookify@claude-plugins-official`. __HOME__ is expanded by install.sh to your actual $HOME. The merge dedupes by command string, so re-running install.sh never doubles a hook.",
  "_note_statusLine": "install.sh only sets statusLine if you do not already have one — it will not clobber an existing statusline.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node __HOME__/.claude/hooks/cc-write-injection-guard.js",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node __HOME__/.claude/hooks/cc-context-monitor.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node __HOME__/.claude/hooks/cc-read-injection-scanner.js",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/hooks/session_snapshot.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/hooks/precompact_session_log.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node __HOME__/.claude/hooks/cc-statusline.js"
  }
}
