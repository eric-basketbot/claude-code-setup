        "_gstack-command": null,
        "codex": "gstack-claude",
        "connect-chrome": null,
        "gstack-upgrade": "gstack-upgrade"
      }
    }
  },
  "project_local_skills": [],
  "required_plugins": {
    "claude": [
      "expo",
      "superpowers"
    ],
    "codex": [
      "expo",
      "superpowers"
    ]
